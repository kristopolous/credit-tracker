# Copy to .env and fill in whatever you've redeemed. Every integration below is optional:
# the aggregator runs in heuristic-only / mock mode with nothing set.

# --- Bright Data (Web Unlocker) -----------------------------------------
# Used to fetch pages that block plain requests. Without it, sources fall
# back to a direct httpx GET, which works for Luma/lablab today but may get
# blocked on some sites.
BRIGHTDATA_API_KEY=
# Find your zone name (it's account-specific, NOT "web_unlocker1" by
# default) with:
#   curl https://api.brightdata.com/zone/get_active_zones -H "Authorization: Bearer $BRIGHTDATA_API_KEY"
BRIGHTDATA_ZONE=

# --- App -------------------------------------------------------------
POLL_INTERVAL_SECONDS=5400
