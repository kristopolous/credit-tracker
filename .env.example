# Copy to .env and fill in whatever you've redeemed. Every integration below is optional:
# the aggregator runs in heuristic-only / mock mode with nothing set.

# --- Bright Data (Web Unlocker) -----------------------------------------
# Used to fetch pages that block plain requests. Without it, sources fall
# back to a direct httpx GET, which works for Luma/lablab today but may get
# blocked on some sites.
BRIGHTDATA_API_KEY=
# Find your zone name (it's account-specific, NOT "web_unlocker1" by
# default) with:
#   curl https://api.brightdata.com/zone/get_active_zones -H "Authorization: Bearer $BRIGHTDATA_API_KEY"
BRIGHTDATA_ZONE=

# --- Cognee (AI memory / knowledge graph) -------------------------------
# Two ways to auth, pick one:
#  - Cloud mode: COGNEE_API_KEY + COGNEE_SERVICE_URL (get the URL from the
#    API Keys page in the Cognee Cloud console - looks like
#    https://your-tenant.aws.cognee.ai). The API key alone isn't enough.
#  - Local mode: LLM_API_KEY only, runs Cognee's pipeline against your own
#    OpenAI-compatible LLM key instead of Cognee Cloud.
COGNEE_API_KEY=
COGNEE_SERVICE_URL=
LLM_API_KEY=
COGNEE_ENABLED=false

# --- AWS Strands Agents --------------------------------------------------
# Used to classify ambiguous text as "real redeemable code" vs noise.
# Without AWS creds, classification falls back to the regex heuristics in
# app/extract/code_detector.py.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
STRANDS_ENABLED=false

# --- App -------------------------------------------------------------
POLL_INTERVAL_SECONDS=5400
